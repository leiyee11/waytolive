# Optional: set a persistent dashboard password. If omitted, the server creates
# a one-time password on first boot and prints it in the server terminal.
ADMIN_PASSWORD=

# Google Calendar API OAuth credentials. Create a Web application OAuth client
# and add this exact callback URL to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/admin/google/callback
GOOGLE_CALENDAR_ID=primary
APP_BASE_URL=

# Public business timezone for calendar event times.
BUSINESS_TIME_ZONE=Asia/Bangkok

# Booking alerts are sent to May after each new request (Resend).
# Verify the sender domain in Resend before using a production sender address.
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Way to Live <bookings@example.com>
BOOKING_NOTIFICATION_EMAIL=may.wytu@gmail.com
